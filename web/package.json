{
  "name": "drill-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts test/*.test.js",
    "vendor": "node scripts/vendor-pyodide.mjs",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.ts",
    "problems": "python3 ../export_cards.py --tests public/problems",
    "predev": "npm run vendor && npm run problems && npm run icons",
    "predeploy": "npm run vendor && npm run problems && npm run icons",
    "db:init": "wrangler d1 execute drill --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute drill --local --file schema.sql",
    "db:migrate-problems": "wrangler d1 execute drill --remote --file migrations/0003_problems.sql",
    "db:migrate-mock": "wrangler d1 execute drill --remote --file migrations/0004_mock.sql",
    "db:migrate-sync": "wrangler d1 execute drill --remote --file migrations/0002_sync.sql",
    "cards": "node scripts/sync-cards.ts --remote",
    "cards:local": "node scripts/sync-cards.ts --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22",
    "pyodide": "^0.27.0",
    "typescript": "^5.8",
    "wrangler": "^4"
  }
}
